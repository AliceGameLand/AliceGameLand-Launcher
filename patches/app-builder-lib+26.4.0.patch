diff --git a/node_modules/app-builder-lib/templates/nsis/uninstaller.nsh b/node_modules/app-builder-lib/templates/nsis/uninstaller.nsh
--- a/node_modules/app-builder-lib/templates/nsis/uninstaller.nsh
+++ b/node_modules/app-builder-lib/templates/nsis/uninstaller.nsh
@@ -5,3 +5,4 @@
 Function un.onInit
-  SetOutPath $INSTDIR
+  # The unelevated process waits for UAC and must not hold the install directory open.
+  SetOutPath "$TEMP"
   ${LogSet} on
@@ -17,4 +18,7 @@ Function un.onInit
   ${If} ${Silent}
     call un.checkAppRunning
   ${else}
+    !ifmacrodef preUnInit
+      !insertmacro preUnInit
+    !endif
     !ifdef ONE_CLICK
diff --git a/node_modules/app-builder-lib/templates/nsis/multiUser.nsh b/node_modules/app-builder-lib/templates/nsis/multiUser.nsh
index c345dee..b5962ce 100644
--- a/node_modules/app-builder-lib/templates/nsis/multiUser.nsh
+++ b/node_modules/app-builder-lib/templates/nsis/multiUser.nsh
@@ -28,14 +28,18 @@ Var installMode
       StrCpy $INSTDIR $perUserInstallationFolder
     ${else}
       StrCpy $0 "$LocalAppData\Programs"
-      System::Store S
-      # Win7 has a per-user programfiles known folder and this can be a non-default location
+      Push $1
+      Push $2
+      StrCpy $2 0
+      # Copy the null-terminated shell path without reading beyond the allocation.
       System::Call 'SHELL32::SHGetKnownFolderPath(g "${FOLDERID_UserProgramFiles}", i ${KF_FLAG_CREATE}, p 0, *p .r2)i.r1'
       ${If} $1 == 0
-        System::Call '*$2(&w${NSIS_MAX_STRLEN} .s)'
-        StrCpy $0 $1
+        System::Call 'KERNEL32::lstrcpynW(w .r0, p r2, i ${NSIS_MAX_STRLEN})p'
+      ${endif}
+      ${If} $2 != 0
         System::Call 'OLE32::CoTaskMemFree(p r2)'
       ${endif}
-      System::Store L
+      Pop $2
+      Pop $1
       StrCpy $INSTDIR "$0\${APP_FILENAME}"
     ${endif}
