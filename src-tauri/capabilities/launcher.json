{
  "identifier": "launcher",
  "description": "Window controls and local launcher commands",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "allow-launcher-snapshot",
    "allow-select-server",
    "allow-play-server",
    "allow-account-profile",
    "allow-microsoft-sign-in"
  ]
}
