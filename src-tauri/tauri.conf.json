{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "앨리스의 게임랜드",
  "version": "../package.json",
  "identifier": "kr.dreamcraft.alicegameland.launcher",
  "build": {
    "beforeBuildCommand": "npm run tauri:ui",
    "beforeDevCommand": "npm run tauri:ui",
    "frontendDist": "../dist/tauri-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://mc-heads.net; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      { "label": "main", "create": false, "title": "앨리스의 게임랜드", "width": 1280, "height": 720, "minWidth": 640, "minHeight": 480, "decorations": false }
    ]
  },
  "bundle": {
    "active": true,
    "icon": ["../build/icon.ico", "icons/icon.icns", "../build/icon.png"]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
