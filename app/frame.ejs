<header id="frameBar" class="<%= process.platform === 'darwin' ? 'frame-mac' : '' %>">
    <% if (process.platform === 'darwin') { %>
        <div id="frameButtonDockDarwin" class="frame-controls">
            <button type="button" class="frameButtonDarwin fCb" id="frameButtonDarwin_close" aria-label="<%= lang('app.close') %>"></button>
            <button type="button" class="frameButtonDarwin fMb" id="frameButtonDarwin_minimize" aria-label="<%= lang('app.minimize') %>"></button>
            <button type="button" class="frameButtonDarwin fRb" id="frameButtonDarwin_restoredown" aria-label="<%= lang('app.resize') %>"></button>
        </div>
    <% } %>
    <div class="frame-brand">
        <img src="assets/images/SealCircle.png" width="32" height="32" alt="">
        <span class="frame-brand-title"><%= lang('app.title') %></span>
    </div>
    <div class="frame-spacer"></div>
    <div id="frameHomeActions" class="frame-home-actions" hidden>
        <button id="launcherUpdateButton" class="quiet-button" type="button" hidden><%= lang('landing.updateAvailableTooltip') %></button>
        <button id="avatarOverlay" class="quiet-button account-button" type="button" title="<%= lang('landing.usernameEditButton') %>">
            <span id="avatarContainer" aria-hidden="true"></span>
            <span id="user_text"><%= lang('landing.usernamePlaceholder') %></span>
        </button>
        <button id="settingsMediaButton" class="quiet-button" type="button">
            <svg class="frame-settings-icon" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M3 5h14M3 10h14M3 15h14M7 3v4m6 1v4m-5 1v4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
            <%= lang('landing.settingsTooltip') %>
        </button>
    </div>
    <% if (process.platform !== 'darwin') { %>
        <div id="frameButtonDockWin" class="frame-controls">
            <button type="button" class="frameButton fMb" id="frameButton_minimize" aria-label="<%= lang('app.minimize') %>">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10"/></svg>
            </button>
            <button type="button" class="frameButton fRb" id="frameButton_restoredown" aria-label="<%= lang('app.resize') %>">
                <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3.5" y="3.5" width="9" height="9"/></svg>
            </button>
            <button type="button" class="frameButton fCb" id="frameButton_close" aria-label="<%= lang('app.close') %>">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 4 8 8m0-8-8 8"/></svg>
            </button>
        </div>
    <% } %>
</header>
