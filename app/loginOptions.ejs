<div id="loginOptionsContainer" class="entry-view" style="display: none;">
    <div class="entry-layout">
        <img class="entry-garden" src="assets/images/backgrounds/0.jpg" width="1500" height="843" alt="">
        <div id="loginOptionsContent" class="entry-panel">
            <div class="loginOptionsMainContent">
                <img class="entry-mascot" src="assets/images/SealCircle.png" width="64" height="64" alt="">
                <div class="login-heading">
                    <h1><%= lang('loginOptions.welcomeTitle') %></h1>
                    <p><span><%= lang('loginOptions.signInDescription') %></span><span><%= lang('loginOptions.playDescription') %></span></p>
                </div>
                <div class="loginOptionActions">
                    <div class="loginOptionButtonContainer">
                        <button id="loginOptionMicrosoft" class="loginOptionButton quiet-button">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 23 23">
                                <path fill="#f35325" d="M1 1h10v10H1z" />
                                <path fill="#81bc06" d="M12 1h10v10H12z" />
                                <path fill="#05a6f0" d="M1 12h10v10H1z" />
                                <path fill="#ffba08" d="M12 12h10v10H12z" />
                            </svg>
                            <span><%- lang('loginOptions.loginWithMicrosoft') %></span>
                        </button>
                    </div>
                </div>
                <div id="loginOptionCancelContainer" style="display: none;">
                    <button id="loginOptionCancelButton" class="quiet-button"><%- lang('loginOptions.cancelButton') %></button>
                </div>
            </div>
        </div>
    </div>
    <script src="./assets/js/scripts/loginOptions.js"></script>
</div>
