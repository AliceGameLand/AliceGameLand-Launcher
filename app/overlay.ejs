<div id="overlayContainer" style="display: none;">
    <div id="serverSelectContent" role="dialog" aria-modal="true" aria-labelledby="serverSelectHeader" tabindex="-1" style="display: none;">
        <h2 id="serverSelectHeader"><%- lang('overlay.serverSelectHeader') %></h2>
        <div id="serverSelectList">
            <div id="serverSelectListScrollable">
                <!-- Server listings populated here. -->
            </div>
        </div>
        <div id="serverSelectActions">
            <button id="serverSelectConfirm" class="overlayKeybindEnter" type="button"><%- lang('overlay.serverSelectConfirm') %></button>
            <div id="serverSelectCancelWrapper">
                <button id="serverSelectCancel" class="overlayKeybindEsc"><%- lang('overlay.serverSelectCancel') %></button>
            </div>
        </div>
    </div>
    <div id="accountSelectContent" role="dialog" aria-modal="true" aria-labelledby="accountSelectHeader" tabindex="-1" style="display: none;">
        <h2 id="accountSelectHeader"><%- lang('overlay.accountSelectHeader') %></h2>
        <div id="accountSelectList">
            <div id="accountSelectListScrollable">
                <!-- Accounts populated here. -->
            </div>
        </div>
        <div id="accountSelectActions">
            <button id="accountSelectConfirm" class="overlayKeybindEnter" type="button"><%- lang('overlay.accountSelectConfirm') %></button>
            <div id="accountSelectCancelWrapper">
                <button id="accountSelectCancel" class="overlayKeybindEsc"><%- lang('overlay.accountSelectCancel') %></button>
            </div>
        </div>
    </div>
    <div id="overlayContent" role="dialog" aria-modal="true" aria-labelledby="overlayTitle" aria-describedby="overlayDesc" tabindex="-1">
        <h2 id="overlayTitle"></h2>
        <p id="overlayDesc"></p>
        <div id="overlayActionContainer">
            <button id="overlayAcknowledge" class="overlayKeybindEnter"></button>
            <div id="overlayDismissWrapper">
                <button id="overlayDismiss" style="display: none;" class="overlayKeybindEsc"></button>
            </div>
        </div>
    </div>
    <div id="launchFailureContent" role="dialog" aria-modal="true" aria-labelledby="launchFailureTitle" aria-describedby="launchFailureDesc" tabindex="-1" style="display: none;">
        <h2 id="launchFailureTitle"></h2>
        <p id="launchFailureDesc"></p>
        <details id="launchFailureDetails">
            <summary><%= lang('overlay.launchFailureDetails') %></summary>
            <pre id="launchFailureDiagnostic"></pre>
            <button id="launchFailureCopy" type="button"><%= lang('overlay.launchFailureCopy') %></button>
            <span id="launchFailureCopyStatus" role="status"></span>
        </details>
        <div class="launch-failure-actions">
            <a id="launchFailureReport" href="<%= lang('settings.supportLink') %>"><%= lang('landing.reportIssue') %></a>
            <button id="launchFailureClose" type="button" class="overlayKeybindEsc"><%= lang('overlay.launchFailureClose') %></button>
            <button id="launchFailureRetry" type="button" class="primary-button overlayKeybindEnter"><%= lang('overlay.launchFailureRetry') %></button>
        </div>
    </div>
    <script src="./assets/js/scripts/overlay.js"></script>
</div>
